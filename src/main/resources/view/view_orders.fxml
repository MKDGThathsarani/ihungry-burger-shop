<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.icet.ihungry.controller.ViewOrdersController">
    <children>
        <!-- උඩ තියෙන රතු පාට Header එක -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#c42d2df2" height="74.0" stroke="BLACK" strokeType="INSIDE" width="600.0" />
        <Label layoutX="87.0" layoutY="19.0" prefHeight="33.0" prefWidth="298.0" text="View Orders" textFill="#fffbfb">
            <font>
                <Font name="Bell MT Bold" size="30.0" />
            </font>
        </Label>

        <!-- වම් පැත්තේ තියෙන ලොකු කළු කොටුව (මෙතන තමයි Table එක දාන්නේ) -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#0a0a0aba" height="213.0" layoutY="80.0" stroke="BLACK" strokeType="INSIDE" width="440.0" />

        <!-- දකුණු පැත්තේ බට්න්ස් ටික තියෙන කළු කොටුව -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#0a0a0aba" height="213.0" layoutX="455.0" layoutY="80.0" stroke="BLACK" strokeType="INSIDE" width="130.0" />

        <!-- බට්න්ස් ටික ලස්සනට එකින් එක තියෙන්න VBox එකක් -->
        <VBox layoutX="460.0" layoutY="100.0" prefWidth="120.0" spacing="15.0">
            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" styleClass="pill-button" text="Delivered" />
            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" styleClass="pill-button" text="Processing" />
            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" styleClass="pill-button" text="Canceled" />
        </VBox>

        <!-- පහළින් තියෙන Back බට්න් එක -->
        <Button layoutX="71.0" layoutY="349.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="80.0" styleClass="pill-button" text="Back" />
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#0a0a0aba" height="65.0" layoutY="335.0" stroke="BLACK" strokeType="INSIDE" width="600.0" />
    </children>
</AnchorPane>
